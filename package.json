{
  "name": "vibesec",
  "displayName": "VibeSec",
  "description": "AI-assisted security scanner for vibe coders",
  "version": "0.4.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibesec.scanCurrentFile",
        "title": "Scan Current File",
        "category": "VibeSec",
        "icon": "$(play)"
      },
      {
        "command": "vibesec.goToFinding",
        "title": "Go to Finding",
        "category": "VibeSec"
      },
      {
        "command": "vibesec.reloadPolicy",
        "title": "Reload Policy",
        "category": "VibeSec",
        "icon": "$(refresh)"
      },
      {
        "command": "vibesec.openPolicyFile",
        "title": "Open Policy File",
        "category": "VibeSec"
      },
      {
        "command": "vibesec.copyDescription",
        "title": "Copy Description",
        "category": "VibeSec",
        "icon": "$(copy)"
      },
      {
        "command": "vibesec.scanSelected",
        "title": "Scan Selected",
        "category": "VibeSec",
        "icon": "$(play)"
      },
      {
        "command": "vibesec.refreshScanTree",
        "title": "Refresh File Tree",
        "category": "VibeSec",
        "icon": "$(refresh)"
      },
      {
        "command": "vibesec.scanWorkspace",
        "title": "Scan Whole Project",
        "category": "VibeSec",
        "icon": "$(run-all)"
      },
      {
        "command": "vibesec.setApiKey",
        "title": "Set API Key",
        "category": "VibeSec"
      },
      {
        "command": "vibesec.clearApiKey",
        "title": "Clear API Key",
        "category": "VibeSec"
      },
      {
        "command": "vibesec.testApiKey",
        "title": "Test API Key",
        "category": "VibeSec"
      },
      {
        "command": "vibesec.generatePrompts",
        "title": "Generate Prompts",
        "category": "VibeSec",
        "icon": "$(sparkle)"
      },
      {
        "command": "vibesec.copyPromptForVuln",
        "title": "Copy Prompt for Vulnerability",
        "category": "VibeSec",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vibesec.copyPromptForFile",
        "title": "Copy Prompt for File",
        "category": "VibeSec",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "vibesec.copyPromptForAll",
        "title": "Copy Prompt for All Findings",
        "category": "VibeSec",
        "icon": "$(comment-discussion)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibesec",
          "title": "VibeSec",
          "icon": "media/vibesec-icon.svg"
        }
      ]
    },
    "views": {
      "vibesec": [
        {
          "id": "vibesec.scanPanel",
          "name": "Scan",
          "contextualTitle": "VibeSec Scan"
        },
        {
          "id": "vibesec.findingsPanel",
          "name": "Findings",
          "contextualTitle": "VibeSec Findings"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vibesec.scanPanel",
        "contents": "Open a folder to browse files and run scans.\n\n[$(folder-opened) Open Folder](command:vscode.openFolder)",
        "when": "vibesec.scanPanelState == 'noWorkspace'"
      },
      {
        "view": "vibesec.findingsPanel",
        "contents": "No scan has run yet.\n\n[$(play) Scan Current File](command:vibesec.scanCurrentFile)\n\n[$(gear) Open Policy File](command:vibesec.openPolicyFile)",
        "when": "vibesec.panelState == 'empty'"
      },
      {
        "view": "vibesec.findingsPanel",
        "contents": "$(pass-filled) No security issues found.\n\nYour last scan came back clean.",
        "when": "vibesec.panelState == 'noFindings'"
      },
      {
        "view": "vibesec.findingsPanel",
        "contents": "$(error) Scan encountered an error.\n\nCheck that Semgrep is installed and on your PATH.\n\n[$(settings-gear) Open VibeSec Settings](command:workbench.action.openSettings?%5B%22vibesec%22%5D)",
        "when": "vibesec.panelState == 'error'"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vibesec.scanSelected",
          "when": "view == vibesec.scanPanel",
          "group": "navigation@1"
        },
        {
          "command": "vibesec.scanWorkspace",
          "when": "view == vibesec.scanPanel",
          "group": "navigation@2"
        },
        {
          "command": "vibesec.refreshScanTree",
          "when": "view == vibesec.scanPanel",
          "group": "navigation@3"
        },
        {
          "command": "vibesec.scanCurrentFile",
          "when": "view == vibesec.findingsPanel",
          "group": "navigation@1"
        },
        {
          "command": "vibesec.generatePrompts",
          "when": "view == vibesec.findingsPanel && vibesec.panelState == 'findings'",
          "group": "navigation@2"
        },
        {
          "command": "vibesec.copyPromptForAll",
          "when": "view == vibesec.findingsPanel && vibesec.panelState == 'findings'",
          "group": "navigation@3"
        },
        {
          "command": "vibesec.reloadPolicy",
          "when": "view == vibesec.findingsPanel",
          "group": "navigation@4"
        }
      ],
      "view/item/inline": [
        {
          "command": "vibesec.copyDescription",
          "when": "view == vibesec.findingsPanel && viewItem == vibesecFindingDetail",
          "group": "inline@1"
        },
        {
          "command": "vibesec.copyPromptForVuln",
          "when": "view == vibesec.findingsPanel && viewItem == vibesecFinding",
          "group": "inline@1"
        },
        {
          "command": "vibesec.copyPromptForFile",
          "when": "view == vibesec.findingsPanel && viewItem == vibesecFile",
          "group": "inline@1"
        }
      ],
      "view/item/context": [
        {
          "command": "vibesec.copyDescription",
          "when": "view == vibesec.findingsPanel && viewItem == vibesecFindingDetail",
          "group": "vibesec@1"
        },
        {
          "command": "vibesec.copyPromptForVuln",
          "when": "view == vibesec.findingsPanel && viewItem == vibesecFinding",
          "group": "vibesec@1"
        },
        {
          "command": "vibesec.copyPromptForFile",
          "when": "view == vibesec.findingsPanel && viewItem == vibesecFile",
          "group": "vibesec@1"
        }
      ],
      "commandPalette": [
        {
          "command": "vibesec.copyDescription",
          "when": "false"
        },
        {
          "command": "vibesec.goToFinding",
          "when": "false"
        },
        {
          "command": "vibesec.copyPromptForVuln",
          "when": "false"
        },
        {
          "command": "vibesec.copyPromptForFile",
          "when": "false"
        }
      ]
    },
    "colors": [
      {
        "id": "vibesec.errorForeground",
        "description": "Color for error-severity findings in the VibeSec panel",
        "defaults": {
          "dark": "#F48771",
          "light": "#E51400",
          "highContrast": "#F48771",
          "highContrastLight": "#E51400"
        }
      },
      {
        "id": "vibesec.warningForeground",
        "description": "Color for warning-severity findings in the VibeSec panel",
        "defaults": {
          "dark": "#CCA700",
          "light": "#915100",
          "highContrast": "#CCA700",
          "highContrastLight": "#915100"
        }
      },
      {
        "id": "vibesec.infoForeground",
        "description": "Color for info-severity findings in the VibeSec panel",
        "defaults": {
          "dark": "#75BEFF",
          "light": "#306EAD",
          "highContrast": "#75BEFF",
          "highContrastLight": "#306EAD"
        }
      }
    ],
    "configuration": {
      "title": "VibeSec",
      "properties": {
        "vibesec.semgrepPath": {
          "type": "string",
          "default": "semgrep",
          "description": "Path to the Semgrep binary. Change this if semgrep is not on your PATH (e.g. /usr/local/bin/semgrep).",
          "scope": "machine-overridable"
        },
        "vibesec.autoScanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan on file save. Off by default — enable only if you want continuous feedback.",
          "scope": "resource"
        },
        "vibesec.showInlineDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show inline diagnostic squiggles for VibeSec findings directly in the editor.",
          "scope": "resource"
        },
        "vibesec.fileExtensions": {
          "type": "string",
          "default": ".py .pyi .js .jsx .mjs .cjs .ts .tsx .java .go .rb .php .c .h .cpp .hpp .cc .cs .rs .swift .kt .kts .scala .yaml .yml .json .html .htm .sh .bash",
          "description": "Space-separated list of file extensions VibeSec will scan (e.g. \".py .ts .go\"). Files outside this list are skipped during multi-target scans and shown as \"not scannable\" in the Scan panel.",
          "scope": "resource"
        },
        "vibesec.llmProvider": {
          "type": "string",
          "enum": ["openai", "anthropic", "gemini"],
          "enumDescriptions": [
            "OpenAI (GPT models). Requires an OpenAI API key.",
            "Anthropic (Claude models). Requires an Anthropic API key.",
            "Google Gemini. Requires a Google AI Studio API key."
          ],
          "default": "anthropic",
          "description": "Which AI provider to use when generating fix prompts. Set the matching API key via the command \"VibeSec: Set API Key\".",
          "scope": "resource"
        },
        "vibesec.llmModel": {
          "type": "string",
          "default": "claude-haiku-4-5",
          "description": "The model id used for prompt generation. Defaults to the cheapest tier for the chosen provider (gpt-5-nano / claude-haiku-4-5 / gemini-2.5-flash-lite). When you switch providers, leave this blank to auto-pick the right default for that provider.",
          "scope": "resource"
        },
        "vibesec.promptMode": {
          "type": "string",
          "enum": ["perFile", "perVulnerability", "perProject"],
          "enumDescriptions": [
            "One prompt per file, batching every finding in that file. Cheapest meaningful option — recommended.",
            "One prompt per finding, plus rolled-up per-file and project-level prompts. Most thorough, most expensive.",
            "A single prompt covering every finding in the scan. Cheapest possible (one API call) but the AI gets a large context."
          ],
          "default": "perFile",
          "description": "How VibeSec should slice prompts when you click \"Generate Prompts\". You can change this any time without re-scanning.",
          "scope": "resource"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "vibesec.gettingStarted",
        "title": "Get started with VibeSec",
        "description": "Scan your code for security issues in three steps.",
        "steps": [
          {
            "id": "vibesec.step.install",
            "title": "Install Semgrep",
            "description": "VibeSec uses Semgrep under the hood. Install it once and you're set.\n\n```\npip install semgrep\n```\n\n[Open Terminal](command:workbench.action.terminal.new)",
            "media": { "markdown": "media/walkthrough/install.md" },
            "completionEvents": []
          },
          {
            "id": "vibesec.step.scan",
            "title": "Run your first scan",
            "description": "Open any file and run a scan — findings appear in the VibeSec panel on the left.\n\n[$(play) Scan Current File](command:vibesec.scanCurrentFile)",
            "media": { "markdown": "media/walkthrough/scan.md" },
            "completionEvents": ["onCommand:vibesec.scanCurrentFile"]
          },
          {
            "id": "vibesec.step.policy",
            "title": "Customize with a policy file",
            "description": "Drop a .vibesec.yaml in your project to control which rules run.\n\n[$(gear) Create Policy File](command:vibesec.openPolicyFile)",
            "media": { "markdown": "media/walkthrough/policy.md" },
            "completionEvents": ["onCommand:vibesec.openPolicyFile"]
          },
          {
            "id": "vibesec.step.prompts",
            "title": "Hook up an AI provider for fix prompts",
            "description": "Add an API key (OpenAI, Anthropic, or Gemini) and VibeSec can generate copy-paste fix prompts for every finding.\n\n[$(key) Set API Key](command:vibesec.setApiKey)",
            "completionEvents": ["onCommand:vibesec.setApiKey"]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "minimatch": "^9.0.4"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/minimatch": "^5.1.2",
    "typescript": "^5.3.0"
  }
}
